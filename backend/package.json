{
  "name": "taskflow-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API REST de TaskFlow (Express + SQLite)",
  "main": "src/server.js",
  "scripts": {
    "test": "jest",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js",
    "test:coverage": "jest --coverage"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.3.0"
  },
  "overrides": {
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.1.1"
    }
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ],
    "coverageReporters": [
      "text-summary",
      "json-summary",
      "lcov"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 95
      }
    }
  }
}
